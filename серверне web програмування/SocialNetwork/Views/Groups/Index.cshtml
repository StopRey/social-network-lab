@model IEnumerable<Group>
@{
    ViewData["Title"] = "Groups";
}

<div class="page-header">
    <h1>Groups</h1>
    <a class="btn btn-primary" asp-action="Create">New group</a>
</div>

<form method="get" class="search" role="search">
    <input type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Name, category or city" />
    <button class="search-btn" type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M16 16l4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
    </button>
</form>

<div class="panel flush">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Group</th>
                <th>Category</th>
                <th>City</th>
                <th>Access</th>
                <th>Members</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var group in Model)
        {
            <tr>
                <td><strong>@group.Name</strong></td>
                <td><span class="pill">@group.Category</span></td>
                <td>@group.City</td>
                <td><span class="pill @(group.IsPrivate ? "solid" : "")">@(group.IsPrivate ? "Private" : "Public")</span></td>
                <td>@group.Memberships.Count</td>
                <td>
                    <div class="actions">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@group.Id">Details</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@group.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@group.Id">Delete</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="empty mt-3">No groups found.</p>
}
