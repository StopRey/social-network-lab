@model IEnumerable<User>
@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <h1>Users</h1>
    <a class="btn btn-primary" asp-action="Create">New user</a>
</div>

<form method="get" class="search" role="search">
    <input type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Name, email or city" />
    <button class="search-btn" type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M16 16l4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
    </button>
</form>

<div class="panel flush">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>User</th>
                <th>City</th>
                <th>Registered</th>
                <th>Groups</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            var initials = $"{user.FirstName.FirstOrDefault()}{user.LastName.FirstOrDefault()}";
            <tr>
                <td>
                    <div class="who">
                        <span class="avatar">@initials</span>
                        <div>
                            <strong>@user.FullName</strong>
                            <small>@user.Email</small>
                        </div>
                    </div>
                </td>
                <td>@user.City</td>
                <td>@user.RegisteredAt.ToString("dd.MM.yyyy")</td>
                <td><span class="pill">@user.Memberships.Count</span></td>
                <td>
                    <div class="actions">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@user.Id">Details</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.Id">Delete</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="empty mt-3">No users found.</p>
}
